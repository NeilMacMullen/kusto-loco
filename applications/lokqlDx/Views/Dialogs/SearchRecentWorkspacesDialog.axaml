<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LokqlDx.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="LokqlDx.Views.Dialogs.SearchRecentWorkspacesDialog"
             x:DataType="vm:SearchRecentWorkspacesViewModel"
             Loaded="UserControl_Loaded"
             MinWidth="500">
    <DockPanel Margin="10">
        <TextBox Name="FilterBox" DockPanel.Dock="Top" PlaceholderText="type words to filter recent workspaces" Text="{Binding FilterText}" />
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Rectangle Width="20" />
            <Button Content="Load" IsDefault="True" Command="{Binding LoadCommand}" />
        </StackPanel>
        <ListBox Name="WorkspaceList" Margin="0,10,0,0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="DoubleTapped">
                    <InvokeCommandAction Command="{Binding LoadCommand}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentWorkspaceItemViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Path}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastAccessedDisplay}" Opacity="0.7" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding PinGlyph}" ToolTip.Tip="Pin to top of list" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"

                                Command="{Binding $parent[ListBox].((vm:SearchRecentWorkspacesViewModel)DataContext).TogglePinCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Content="&#x1F5D1;" ToolTip.Tip="Remove from recent workspaces" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                Command="{Binding $parent[ListBox].((vm:SearchRecentWorkspacesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
